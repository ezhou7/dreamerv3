<?xml version="1.0" ?>

<!-- QWinOut F450 quad (450 mm wheelbase, 1045 props) for gym-pybullet-drones.

The file name still says 12in; since 2026-10-17 the values match
aerial/configs/airframe_12in.py DEFAULT_12IN (the F450 parts table).
aerial/tests/test_airframe.py checks that the two agree.

Derivations (BaseAviary uses G = 9.8):
  mass 1.634 kg (with camera), max thrust 8.0 N/motor at 8000 RPM
  kf = 8.0 / 8000^2 = 1.25e-7 N/RPM^2
  km = 0.017 m * kf = 2.125e-9 N*m/RPM^2
  thrust2weight = 4 * 8.0 / (1.634 * 9.8) = 1.99835  => MAX_RPM = 8000

Rotor drag (BaseAviary: F = -coeff * sum(rotor rad/s) * v_body), sized
so that at hover (sum = 2372 rad/s) it decelerates the vehicle at
0.25 1/s horizontally and 0.30 1/s vertically:
  drag_coeff_xy = 1.634 * 0.25 / 2372 = 1.722e-4
  drag_coeff_z  = 1.634 * 0.30 / 2372 = 2.067e-4

Ground effect: thrust gain = coeff * (R / 4h)^2 with h the prop height.
coeff 6.4 gives about +10% at h = 2R and +2.5% at h = 4R, roughly what
full-multirotor measurements show (stronger than the single-rotor
Cheeseman-Bennett model). cf2x's fitted 11.37 is about twice that.

Prop links carry the prop-disk position (motor x/y, 5.5 cm above the
arms) so ground effect is measured at the props. Collision: frame and
arms, the four prop disks, the four 140 mm legs, and the gimbal.
Standing on its legs, the body origin is 0.155 m above the ground.
Downwash coefficients are cf2x values; they only matter with several
drones.
-->

<robot name="cf12in">

  <properties arm="0.225" kf="1.25e-7" km="2.125e-9" thrust2weight="1.99835" max_speed_kmh="60" gnd_eff_coeff="6.4" prop_radius="0.127" drag_coeff_xy="1.722e-4" drag_coeff_z="2.067e-4" dw_coeff_1="2267.18" dw_coeff_2=".16" dw_coeff_3="-.11" />

  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1.634"/>
      <inertia ixx="0.01763" ixy="0.0" ixz="0.0" iyy="0.01835" iyz="0.0" izz="0.02120"/>
    </inertial>

    <!-- BaseAviary reads this link positionally: child 1 must be a
         visual and child 2 a cylinder collision (the center body). -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.07" length="0.04"/>
      </geometry>
      <material name="dark_grey">
        <color rgba=".3 .3 .3 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.07" length="0.04"/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="0 0 0.7854" xyz="0 0 0"/>
      <geometry>
        <box size="0.48 0.04 0.025"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <visual>
      <origin rpy="0 0 -0.7854" xyz="0 0 0"/>
      <geometry>
        <box size="0.48 0.04 0.025"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>

    <!-- Arms (two crossed bars). -->
    <collision>
      <origin rpy="0 0 0.7854" xyz="0 0 0"/>
      <geometry>
        <box size="0.48 0.04 0.025"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 -0.7854" xyz="0 0 0"/>
      <geometry>
        <box size="0.48 0.04 0.025"/>
      </geometry>
    </collision>
    <!-- Prop disks. -->
    <collision>
      <origin rpy="0 0 0" xyz="0.1591 -0.1591 0.055"/>
      <geometry>
        <cylinder radius="0.127" length="0.01"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="-0.1591 -0.1591 0.055"/>
      <geometry>
        <cylinder radius="0.127" length="0.01"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="-0.1591 0.1591 0.055"/>
      <geometry>
        <cylinder radius="0.127" length="0.01"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0.1591 0.1591 0.055"/>
      <geometry>
        <cylinder radius="0.127" length="0.01"/>
      </geometry>
    </collision>
    <!-- 140 mm legs under the bottom plate; feet end at z = -0.155. -->
    <collision>
      <origin rpy="0 0 0" xyz="0.0849 -0.0849 -0.085"/>
      <geometry>
        <box size="0.015 0.015 0.14"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="-0.0849 -0.0849 -0.085"/>
      <geometry>
        <box size="0.015 0.015 0.14"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="-0.0849 0.0849 -0.085"/>
      <geometry>
        <box size="0.015 0.015 0.14"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0.0849 0.0849 -0.085"/>
      <geometry>
        <box size="0.015 0.015 0.14"/>
      </geometry>
    </collision>
    <!-- Gimbal + camera, hanging below the bottom plate; clears the feet
         by 1.5 cm. -->
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.10"/>
      <geometry>
        <box size="0.08 0.08 0.08"/>
      </geometry>
    </collision>
  </link>

  <link name="prop0_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.1591 -0.1591 0.055"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
  <joint name="prop0_joint" type="fixed">
    <parent link="base_link"/>
    <child link="prop0_link"/>
  </joint>

  <link name="prop1_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.1591 -0.1591 0.055"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
  <joint name="prop1_joint" type="fixed">
    <parent link="base_link"/>
    <child link="prop1_link"/>
  </joint>

  <link name="prop2_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.1591 0.1591 0.055"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
  <joint name="prop2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="prop2_link"/>
  </joint>

  <link name="prop3_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.1591 0.1591 0.055"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
  <joint name="prop3_joint" type="fixed">
    <parent link="base_link"/>
    <child link="prop3_link"/>
  </joint>

  <link name="center_of_mass_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
  <joint name="center_of_mass_joint" type="fixed">
    <parent link="base_link"/>
    <child link="center_of_mass_link"/>
  </joint>

</robot>
